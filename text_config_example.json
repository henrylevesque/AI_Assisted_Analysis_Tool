{
  "_comment": "Example JSON config for text_analysis.py. Run with: python text_analysis.py --config text_config.json --no-interactive",
  "models": ["gemma3:12b"],
  "prompt_desc": "Main topic or theme",
  "input": "./data/text_input/abstracts.xlsx",
  "output": "./data/text_output/",
  "id_col": "id",
  "content_col": "abstract",
  "runs": 5,
  "timeout": 120,
  "retries": 2,
  "within_model_consensus": true,
  "within_model_consensus_mode": "fuzzy",
  "within_model_fuzzy_threshold": 85,
  "between_model_consensus": false,
  "between_model_consensus_mode": "exact",
  "between_model_fuzzy_threshold": 85,
  "aggregate": false,
  "aggregated_consensus_mode": "exact",
  "aggregated_fuzzy_threshold": 85,
  "delay": 0.0,
  "append_metadata": true
}
